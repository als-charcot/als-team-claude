# All data lives here, in one place — distributed separately, never committed
data/

# Researchers' own analyses live here and stay local (each can be its own repo)
projects/

# Python / Jupyter junk
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# OS junk
.DS_Store
Thumbs.db

# Research-watch digests: local until deliberately promoted via share-work.
# LEADING SLASH IS LOAD-BEARING: an unanchored 'research-watch/' also matches
# .claude/skills/research-watch/ and silently excluded the whole skill from a commit.
/research-watch/

# Markdown produced by the document-conversion hook. Derived, never shared.
/.converted/

# Cached cross-branch state for the session hooks. Derived, never shared.
/.state/
